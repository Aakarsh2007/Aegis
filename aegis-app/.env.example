# ─── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get this from: https://neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/aegis?sslmode=require

# ─── Better Auth ────────────────────────────────────────────────────────────
# Random secret for session signing — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_64_hex_char_random_string

# Public URL of this application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Field Encryption ───────────────────────────────────────────────────────
# AES-256-GCM key — generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
FIELD_ENCRYPTION_KEY=replace_with_64_hex_char_random_string

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ─── AI / Gemini ─────────────────────────────────────────────────────────────
# Global fallback Gemini API key — get from: https://aistudio.google.com
# Users can also supply their own per-account key in settings
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ─── Thresholds ──────────────────────────────────────────────────────────────
CPU_THRESHOLD=80
MEM_THRESHOLD=90
