# ─── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/aegis?sslmode=require

# ─── Better Auth ────────────────────────────────────────────────────────────
# CRITICAL: Must match your deployed URL exactly (no trailing slash)
# For Vercel: https://your-project.vercel.app
# For local:  http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Generate with: openssl rand -hex 32  (must be 32+ chars)
BETTER_AUTH_SECRET=your_64_hex_char_secret_here

# CRITICAL: Add your deployed URL here to prevent "invalid origin" errors
# This must match NEXT_PUBLIC_APP_URL exactly
BETTER_AUTH_TRUSTED_ORIGINS=https://your-project.vercel.app

# ─── Field Encryption ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars)
FIELD_ENCRYPTION_KEY=your_64_hex_char_key_here

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# 1. Go to: https://github.com/settings/applications/new
# 2. Homepage URL: https://your-project.vercel.app
# 3. Callback URL: https://your-project.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ─── AI / Gemini ─────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ─── Alert Thresholds ────────────────────────────────────────────────────────
CPU_THRESHOLD=80
MEM_THRESHOLD=90
