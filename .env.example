# ─── Database ────────────────────────────────────────────────────────────────
DB_PASSWORD=your_secure_db_password_here
# Full connection string (used by orchestrator and setup_db)
DATABASE_URL=postgres://aegis:your_secure_db_password_here@localhost:5432/aegis

# ─── Orchestrator ─────────────────────────────────────────────────────────────
# 256-bit secret for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_char_random_string

# 256-bit key for AES-256-GCM field encryption — generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace_with_64_hex_char_random_string

# CPU alert threshold in percent (default: 80)
CPU_THRESHOLD=80

# Memory alert threshold in percent (default: 90)
MEM_THRESHOLD=90

# URL of the AI Agent service (internal Docker network name in production)
AI_AGENT_URL=http://localhost:8000

# CORS: the origin of the dashboard (no trailing slash)
ALLOWED_ORIGIN=http://localhost:3001

# Public URL of the orchestrator (shown in the probe install command)
ORCHESTRATOR_URL=http://localhost:3000

# Set to "true" to bypass API key auth and enable local development mode
LOCAL_MODE=false

# ─── AI Agent ─────────────────────────────────────────────────────────────────
# Global fallback Gemini API key (tenants can supply their own per-account)
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL that the browser calls for API requests (must be publicly reachable)
NEXT_PUBLIC_API_URL=http://localhost:3000
